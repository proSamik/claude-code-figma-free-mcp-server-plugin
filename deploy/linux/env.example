# Copy to ~/.config/claude-code-figma/env and edit. Read by the systemd units and scripts.

# Where this repo is checked out.
REPO_DIR=$HOME/claude-code-figma-free-mcp-server-plugin

# Relay. Keep 127.0.0.1 when the MCP server runs on the same host.
# Use the Docker bridge address (e.g. 172.17.0.1) or 0.0.0.0 only if containers or
# other machines must reach it, and firewall the port.
RELAY_HOST=127.0.0.1
RELAY_PORT=3055

# Virtual display for headless Figma.
FIGMA_DISPLAY=:99
FIGMA_SCREEN=1920x1080x24

# Optional: the Figma file to open automatically (any figma.com/design/... URL).
FIGMA_FILE_URL=

# Must match "name" in src/cursor_mcp_plugin/manifest.json.
PLUGIN_NAME="Claude Code Figma MCP"

# Optional: also write the current channel here (e.g. a folder an agent container can read).
CHANNEL_FILE=
