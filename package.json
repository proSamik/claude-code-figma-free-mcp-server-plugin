{
  "name": "claude-code-figma-free-mcp-server-plugin",
  "description": "Free Figma MCP server + plugin for Claude Code, Codex and other MCP clients: read and edit real Figma files, bulk export, and a 24/7 headless Linux setup. Fork of cursor-talk-to-figma-mcp.",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proSamik/claude-code-figma-free-mcp-server-plugin.git"
  },
  "homepage": "https://github.com/proSamik/claude-code-figma-free-mcp-server-plugin#readme",
  "bugs": {
    "url": "https://github.com/proSamik/claude-code-figma-free-mcp-server-plugin/issues"
  },
  "module": "dist/server.js",
  "main": "dist/server.js",
  "bin": {
    "claude-code-figma-mcp": "dist/server.js",
    "cursor-talk-to-figma-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "src/socket.ts",
    "src/channel.ts",
    "src/cursor_mcp_plugin",
    "deploy"
  ],
  "type": "module",
  "scripts": {
    "start": "bun run dist/server.js",
    "socket": "bun run src/socket.ts",
    "setup": "./scripts/setup.sh",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "bun run build:watch",
    "pub:release": "bun run build && npm publish",
    "test": "bun run build && bun test tests",
    "typecheck": "tsc --noEmit",
    "release": "./scripts/release.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "^1.2.5",
    "tsup": "^8.4.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.13.1",
    "uuid": "latest",
    "ws": "latest",
    "zod": "3.22.4"
  },
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "figma-plugin",
    "headless",
    "bulk-export"
  ]
}
